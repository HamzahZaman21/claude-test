# Non-secret configuration defaults for Decrypt.
# Safe to commit. Real secrets live in .env.local / .env.mcp (gitignored) and are
# referenced by .env.secrets.template (names only).

# --- Gameplay timers (server-anchored; seconds) ---
CLUE_PHASE_SECONDS=90
GUESS_PHASE_SECONDS=60

# --- Board configuration ---
BOARD_SIZE=25              # 5x5
STARTING_TEAM_AGENTS=9
OTHER_TEAM_AGENTS=8
NEUTRAL_CARDS=7
ASSASSIN_CARDS=1

# --- Room/codes ---
ROOM_CODE_LENGTH=6
ROOM_CODE_ALPHABET=ABCDEFGHJKMNPQRSTUVWXYZ23456789   # no ambiguous 0/O/1/I/L

# --- Team identity colors (mirror DESIGN-SYSTEM.md tokens) ---
TEAM_CYAN_COLOR=#22D3EE
TEAM_AMBER_COLOR=#F59E0B
NEUTRAL_COLOR=#9CA3AF
ASSASSIN_COLOR=#EF4444

# --- Realtime ---
REALTIME_PROPAGATION_TARGET_MS=500
PRESENCE_LEAVE_TIMEOUT_MS=5000
