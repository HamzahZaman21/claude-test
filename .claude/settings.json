{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-protected-files.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/check-stable.js"
          }
        ]
      }
    ]
  }
}
