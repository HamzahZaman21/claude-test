# Secret variable NAMES only — copy to .env.secrets and fill with real values.
# NEVER commit real values. The app currently reads runtime values from .env.local
# and MCP/deploy tokens from .env.mcp (both gitignored). This template documents the
# full set of secrets the project depends on.

# --- Public (client) config — safe to expose to the browser ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=

# --- Server-only secrets — NEVER prefix with NEXT_PUBLIC ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# --- Deploy ---
VERCEL_TOKEN=

# --- Forge engine (configured in the workflow system, not here) ---
LLM_API_KEY=
